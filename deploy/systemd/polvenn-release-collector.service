[Unit]
Description=Polvenn Release Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=polvenn
Group=polvenn
WorkingDirectory=/opt/polvenn-release-collector
EnvironmentFile=/etc/polvenn-release-collector.env
ExecStart=/usr/bin/node /opt/polvenn-release-collector/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=
CapabilityBoundingSet=
DevicePolicy=closed
KeyringMode=private
LockPersonality=true
PrivateDevices=true
PrivateIPC=true
PrivateTmp=true
ProcSubset=pid
ProtectClock=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ReadWritePaths=/var/lib/polvenn-release-collector
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
